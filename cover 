    </section>

    <!-- Intellectual Property Attribution -->
    <footer>
      <p>Authored, innovated, and documented by <strong>عبدالعزيز سيف النصر</strong> — <strong>Abdul-Aziz Saif AlNassr</strong> (08 نوفمبر 2026).</p>
    </footer>
  </main>

  <script>
    function setLanguage(lang) {
      const htmlEl = document.documentElement;
      htmlEl.lang = lang;
      htmlEl.dir = lang === "ar" ? "rtl" : "ltr";

      document.querySelectorAll(".lang-block").forEach((block) => {
        block.classList.toggle("active", block.dataset.lang === lang);
      });

      document.querySelectorAll(".lang-btn").forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.target === lang);
      });
    }

    function playHarmonicChime() {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (!AudioCtx) return;

      const ctx = new AudioCtx();
      const baseFreq = 216;
      const ratio = 1.989849;
      const frequencies = [baseFreq, baseFreq * 1.5, baseFreq * ratio];

      frequencies.forEach((freq, index) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(freq, ctx.currentTime + index * 0.18);

        gain.gain.setValueAtTime(0.001, ctx.currentTime + index * 0.18);
        gain.gain.exponentialRampToValueAtTime(0.14, ctx.currentTime + index * 0.18 + 0.08);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + index * 0.18 + 1.8);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime + index * 0.18);
        osc.stop(ctx.currentTime + index * 0.18 + 1.85);
      });
    }
  </script>
</body>
</html>
