<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>مختبر التناغم الذهبي للمعامل الملكي</title>
  <style>
    :root {
      --bg-deep: #0b0d12;
      --bg-card: rgba(20, 24, 34, 0.78);
      --gold-primary: #d4af37;
      --gold-soft: #f3e09d;
      --gold-border: rgba(212, 175, 55, 0.35);
      --text-main: #f5f5f7;
      --text-muted: #b8bcc8;
      --accent-glow: rgba(212, 175, 55, 0.14);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 20% 20%, rgba(212, 175, 55, 0.12), transparent 45%),
        radial-gradient(circle at 80% 80%, rgba(212, 175, 55, 0.08), transparent 50%),
        var(--bg-deep);
      color: var(--text-main);
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.75;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2rem 1.25rem 3.5rem;
    }

    .container {
      width: 100%;
      max-width: 920px;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    /* Language Switcher */
    .lang-bar {
      display: flex;
      justify-content: center;
      gap: 0.65rem;
    }

    .lang-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--gold-border);
      color: var(--gold-soft);
      padding: 0.45rem 1.1rem;
      border-radius: 999px;
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.25s ease;
    }

    .lang-btn:hover,
    .lang-btn.active {
      background: var(--gold-primary);
      color: #0b0d12;
      box-shadow: 0 0 18px rgba(212, 175, 55, 0.35);
    }

    /* Hero Card */
    .hero-card,
    .glass-card {
      background: var(--bg-card);
      border: 1px solid var(--gold-border);
      border-radius: 20px;
      padding: 2.25rem 2rem;
      backdrop-filter: blur(14px);
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45), inset 0 0 30px var(--accent-glow);
    }

    .hero-card {
      text-align: center;
    }

    .main-title {
      font-size: clamp(1.7rem, 4vw, 2.5rem);
      font-weight: 700;
      color: var(--gold-soft);
      letter-spacing: 0.3px;
      margin-bottom: 0.65rem;
    }

    .tagline {
      font-size: 1.15rem;
      color: var(--gold-primary);
      font-weight: 600;
      margin-bottom: 1.35rem;
    }

    .voice-announcement {
      background: rgba(212, 175, 55, 0.09);
      border: 1px dashed var(--gold-border);
      border-radius: 14px;
      padding: 1rem 1.25rem;
      color: var(--text-main);
      font-size: 0.98rem;
      max-width: 720px;
      margin: 0 auto 1.65rem;
    }

    .cta-group {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.9rem;
    }

    .btn-primary,
    .btn-secondary {
      text-decoration: none;
      padding: 0.8rem 1.75rem;
      border-radius: 12px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.25s ease;
      border: none;
    }

    .btn-primary {
      background: linear-gradient(135deg, #e5c453, #b99221);
      color: #0b0d12;
      box-shadow: 0 8px 24px rgba(212, 175, 55, 0.3);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(212, 175, 55, 0.45);
    }

    .btn-secondary {
      background: transparent;
      border: 1px solid var(--gold-border);
      color: var(--gold-soft);
    }

    .btn-secondary:hover {
      background: rgba(212, 175, 55, 0.12);
    }

    /* Mission & Vision Section */
    .mv-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    @media (min-width: 720px) {
      .mv-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    .mv-item {
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid rgba(212, 175, 55, 0.22);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .mv-item h2 {
      font-size: 1.25rem;
      color: var(--gold-soft);
      margin-bottom: 0.65rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .mv-item p {
      color: var(--text-muted);
      font-size: 0.98rem;
    }

    .mv-item strong,
    .mv-item em {
      color: var(--gold-soft);
      font-style: normal;
      font-weight: 600;
    }

    /* Language visibility */
    .lang-block {
      display: none;
    }

    .lang-block.active {
      display: block;
    }

    /* Footer Attribution */
    footer {
      text-align: center;
      margin-top: 0.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid rgba(212, 175, 55, 0.2);
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    footer strong {
      color: var(--gold-soft);
    }
  </style>
</head>
<body>
  <main class="container">
    <!-- Language Switcher -->
    <nav class="lang-bar" aria-label="Language selector">
      <button class="lang-btn active" data-target="ar" onclick="setLanguage('ar')">العربية</button>
      <button class="lang-btn" data-target="en" onclick="setLanguage('en')">English</button>
      <button class="lang-btn" data-target="fr" onclick="setLanguage('fr')">Français</button>
    </nav>

    <!-- Hero Cover Section -->
    <section class="hero-card">
      <h1 class="main-title">مختبر التناغم الذهبي للمعامل الملكي</h1>

      <!-- Arabic Hero -->
      <div class="lang-block active" data-lang="ar" dir="rtl">
        <p class="tagline">التناغم الملكي 🪞 الواقع الذهبي</p>
        <div class="voice-announcement">
